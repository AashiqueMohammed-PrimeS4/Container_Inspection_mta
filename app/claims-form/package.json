{
  "name": "claims-form",
  "version": "0.1.0",
  "description": "Public carrier claim form, bundled into the claims-form app router.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=esm --minify --outfile=router/resources/claim/bundle.js && cp index.html router/resources/claim/",
