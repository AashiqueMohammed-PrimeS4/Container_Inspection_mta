{
  "welcomeFile": "/claim/",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/claim/(.*)$",
      "target": "$1",
      "localDir": "resources/claim",
      "authenticationType": "none",
      "cacheControl": "no-cache, no-store, must-revalidate"
    },
    {
      "source": "^/public/(.*)$",
      "target": "/odata/v4/claims-public/$1",
      "destination": "SmartInspect_Claims_Public",
      "authenticationType": "none",
      "csrfProtection": false
    }
  ]
}
