<mvc:View
    controllerName="carrieranalytics.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data"
    displayBlock="true"
>
    <!-- Start Depenedents -->
    <mvc:dependents>
        <Popover
            id="chatDialog"
            contentWidth="400px"
            placement="Left"
            afterOpen="onChatAfterOpen"
        >
            <customHeader>
                <Bar
                    design="Auto"
                    titleAlignment="None"
                >
                    <contentLeft>
                        <Title text="PRIVA Assists" />
                    </contentLeft>
                    <contentRight>
                        <Button
                            icon="sap-icon://decline"
                            type="Transparent"
                            press="onCloseChat"
                        />
                    </contentRight>
                </Bar>
            </customHeader>
            <content>
                <VBox
                    height="100%"
                    justifyContent="SpaceBetween"
                >
                    <!-- Message Area -->
                    <ScrollContainer
                        id="chatScroll"
                        height="300px"
                        vertical="true"
                        focusable="false"
                    >
                        <List
                            items="{chatModel>/messages}"
                            showSeparators="None"
                        >
                            <items>
                                <CustomListItem>
                                    <HBox
                                        justifyContent="{= ${chatModel>sender} === 'Me' ? 'End' : 'Start' }"
                                        alignItems="End"
                                        class="sapUiSmallMargin"
                                    >
                                        <!-- Bot Avatar (Left Side) -->
                                        <Avatar
                                            src="sap-icon://SAP-icons-TNT/robot"
                                            displaySize="XS"
                                            displayShape="Square"
                                            backgroundColor="Accent3"
                                            visible="{= ${chatModel>sender} !== 'Me' }"
                                            class="sapUiTinyMarginEnd"
                                        />
                                        <!-- MessageStrip Bubble -->
                                        <MessageStrip
                                            text="{= ${chatModel>typing} === true ? '...' : ${chatModel>text} }"
                                            type="{= ${chatModel>sender} === 'Me' ? 'Success' : 'Warning' }"
                                            showIcon="false"
                                            class="sapUiTinyMarginTop sapUiTinyMarginBottom"
                                        />
                                        <!-- User Avatar (Right Side) -->
                                        <Avatar
                                            initials="{
                                                path: 'chatModel>/userName',
                                                formatter: '.formatInitial'
                                            }"
                                            displaySize="XS"
                                            displayShape="Square"
                                            backgroundColor="Accent9"
                                            visible="{= ${chatModel>sender} === 'Me' }"
                                            class="sapUiTinyMarginBegin"
                                        />
                                    </HBox>
                                </CustomListItem>
                            </items>
                        </List>
                    </ScrollContainer>
                    <!-- Suggestion Chips -->
                    <HBox
                        items="{chatModel>/suggestions}"
                        wrap="Wrap"
                        class="sapUiTinyMarginBegin sapUiTinyMarginEnd sapUiTinyMarginBottom"
                    >
                        <Button
                            text="{chatModel>title}"
                            type="Ghost"
                            press="onSuggestionItemPress"
                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                        />
                    </HBox>
                    <!-- Input Section -->
                    <Toolbar>
                        <Input
                            id="chatInput"
                            width="100%"
                            placeholder="Ask PRIVA"
                            submit="onPostMessage"
                        />
                        <Button
                            icon="sap-icon://paper-plane"
                            type="Emphasized"
                            press="onPostMessage"
                        />
                    </Toolbar>
                </VBox>
            </content>
        </Popover>
    </mvc:dependents>
    <!-- End of AI Dependents -->
    <Page
        id="page"
        title="SmartInspect Insights"
        titleAlignment="Center"
    >
        <subHeader>
            <Bar>
                <contentMiddle>
                     <Label text="AI-Powered Inspection Intelligence &amp; Operational Visibility" design="Bold"/>
                </contentMiddle>
            </Bar>
        </subHeader>
       
        <headerContent>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button
                text="PRIVA Assist"
                    id="floatingActionBtn"
                    icon="sap-icon://da-2"
                    type="Transparent"
                    tooltip="PRIVA Assists"
                    press="onFloatingPress"
                />
            </OverflowToolbar>
        </headerContent>
        <content>
            <VBox
                id="mainVBox"
                class="sapUiMediumMargin"
            >
                <!-- ========== Date Range Selection for Inspection Data ========== -->
                <VBox
                    id="datePickerSection"
                    class="sapUiSmallMarginBottom"
                >
                    <Label
                        id="dateLabel"
                        text="Select Inspection Date Range"
                        design="Bold"
                    />
                    <DateRangeSelection
                        id="inspectionDateRangePicker"
                        placeholder="Choose a date range"
                        displayFormat="dd/MM/yyyy"
                        change="onDateRangeChangeMain"
                        width="250px"
                    />
                </VBox>
                <!-- Tiles Section -->
                <l:HorizontalLayout
                    id="tilesLayout"
                    class="sapUiMediumMarginTop"
                    allowWrapping="true"
                >
                    <!-- Tile 1: Accepted Carriers -->
                    <GenericTile
                        id="acceptedTile"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                        header="Accepted Inspections"
                        frameType="OneByOne"
                    >
                        <TileContent id="acceptedTileContent">
                            <NumericContent
                                id="acceptedNumericContent"
                                value="{viewModel>/acceptedCount}"
                                icon="sap-icon://inventory"
                                valueColor="Good"
                                withMargin="false"
                            />
                        </TileContent>
                    </GenericTile>
                    <!-- Tile 2: Rejected Carriers -->
                    <GenericTile
                        id="rejectedTile"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                        header="Rejected Inspections"
                        frameType="OneByOne"
                    >
                        <TileContent id="rejectedTileContent">
                            <NumericContent
                                id="rejectedNumericContent"
                                value="{viewModel>/rejectedCount}"
                                icon="sap-icon://inventory"
                                valueColor="Error"
                                withMargin="false"
                            />
                        </TileContent>
                    </GenericTile>
                    <!-- Tile 3: Carrier Reservation Sheet  -->
                    <GenericTile
                        id="reservationSheetTile"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                        header="Inspection Reports"
                        subheader="View Report"
                        frameType="OneByOne"
                        press="onNavigateToCarrierReport"
                    >
                        <TileContent id="reservationSheetTileContent">
                            <ImageContent
                                id="reservationSheetImage"
                                src="sap-icon://manager-insight"
                            />
                        </TileContent>
                    </GenericTile>
                    <!-- Tile 4: Carrier AI Summary -->
                    <GenericTile
                        id="aiSummaryTile"
                        class="sapUiTinyMarginBottom"
                        header="PRIVA Summary"
                        subheader="View PRIVA Summary"
                        frameType="OneByOne"
                        press="onNavigateToAiSummary"
                    >
                        <TileContent id="aiSummaryTileContent">
                            <ImageContent src="sap-icon://ai" />
                        </TileContent>
                    </GenericTile>

                    

                </l:HorizontalLayout>
            </VBox>
        </content>
    </Page>
</mvc:View>