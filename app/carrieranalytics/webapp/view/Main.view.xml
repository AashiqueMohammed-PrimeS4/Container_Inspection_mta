<mvc:View
    controllerName="carrieranalytics.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data"
    displayBlock="true"
>
    <!-- Start Depenedents -->
    <mvc:dependents>
        <Popover
            id="chatDialog"
            contentWidth="420px"
            placement="Left"
            afterOpen="onChatAfterOpen"
            class="privaPopover"
        >
            <customHeader>
                <Bar
                    design="Auto"
                    titleAlignment="None"
                >
                    <contentLeft>
                        <core:Icon
                            src="sap-icon://da-2"
                            color="#a228c7"
                            size="1.2rem"
                            class="sapUiTinyMarginEnd"
                        />
                        <Title text="PRIVA Assists" />
                    </contentLeft>
                    <contentRight>
                        <Button
                            icon="sap-icon://decline"
                            type="Transparent"
                            press="onCloseChat"
                        />
                    </contentRight>
                </Bar>
            </customHeader>
            <content>
                <VBox class="privaChat">
                    <!-- Message Area — fixed height always, suggestions float inside -->
                    <ScrollContainer
                        id="chatScroll"
                        height="600px"
                        vertical="true"
                        horizontal="false"
                        focusable="false"
                    >
                        <VBox class="privaChatInner">
                            <List
                                items="{chatModel>/messages}"
                                showSeparators="None"
                                class="privaChatList"
                            >
                                <items>
                                    <CustomListItem>
                                        <HBox
                                            justifyContent="{= ${chatModel>sender} === 'Me' ? 'End' : 'Start' }"
                                            alignItems="Start"
                                            class="privaMsgRow"
                                        >
                                            <!-- Bot Avatar -->
                                            <Avatar
                                                src="sap-icon://da-2"
                                                displaySize="XS"
                                                displayShape="Circle"
                                                backgroundColor="Accent9"
                                                visible="{= ${chatModel>sender} !== 'Me' }"
                                                class="sapUiTinyMarginEnd privaAvatar"
                                            />
                                            <!-- Bot Bubble -->
                                            <VBox
                                                visible="{= ${chatModel>sender} !== 'Me' }"
                                                class="privaBotBubble"
                                            >
                                                <Text
                                                    text="{= ${chatModel>typing} === true ? '...' : ${chatModel>text} }"
                                                    wrapping="true"
                                                    class="privaBotText"
                                                />
                                            </VBox>
                                            <!-- User Bubble -->
                                            <VBox
                                                visible="{= ${chatModel>sender} === 'Me' }"
                                                class="privaUserBubble"
                                            >
                                                <Text
                                                    text="{chatModel>text}"
                                                    wrapping="true"
                                                    class="privaUserText"
                                                />
                                            </VBox>
                                            <!-- User Avatar -->
                                            <Avatar
                                                initials="{
                                                    path: 'chatModel>/userName',
                                                    formatter: '.formatInitial'
                                                }"
                                                displaySize="XS"
                                                displayShape="Circle"
                                                backgroundColor="Accent6"
                                                visible="{= ${chatModel>sender} === 'Me' }"
                                                class="sapUiTinyMarginBegin privaAvatar"
                                            />
                                        </HBox>
                                    </CustomListItem>
                                </items>
                            </List>
                            <!-- Suggestion Chips — inside scroll area, disappear on first message -->
                            <HBox
                                id="suggestionBox"
                                items="{chatModel>/suggestions}"
                                wrap="Wrap"
                                visible="{chatModel>/showSuggestions}"
                                class="privaSuggestions"
                            >
                                <Button
                                    text="{chatModel>title}"
                                    type="Ghost"
                                    press="onSuggestionItemPress"
                                    class="sapUiTinyMarginEnd sapUiTinyMarginBottom privaSuggestionBtn"
                                />
                            </HBox>
                        </VBox>
                    </ScrollContainer>
                    <!-- Input Section -->
                    <Toolbar class="privaInputBar">
                        <Input
                            id="chatInput"
                            width="100%"
                            placeholder="Ask PRIVA anything..."
                            submit="onPostMessage"
                        />
                        <Button
                            icon="sap-icon://paper-plane"
                            type="Emphasized"
                            press="onPostMessage"
                            class="privaBtn"
                        />
                    </Toolbar>
                </VBox>
            </content>
        </Popover>
    </mvc:dependents>
    <!-- End of AI Dependents -->
    <Page
        id="page"
        title="SmartInspect Insights"
        titleAlignment="Center"
    >
        <subHeader>
            <Bar>
                <contentMiddle>
                     <Label text="AI-Powered Inspection Intelligence &amp; Operational Visibility" design="Bold"/>
                </contentMiddle>
            </Bar>
        </subHeader>
       
        <headerContent>
            <OverflowToolbar design="Transparent">
                <ToolbarSpacer />
                <Button
                    text="PRIVA Assist"
                    id="floatingActionBtn"
                    icon="sap-icon://da-2"
                    type="Ghost"
                    tooltip="PRIVA Assists"
                    press="onFloatingPress"
                    class="privaAssistBtn"
                />
            </OverflowToolbar>
        </headerContent>
        <content>
            <VBox
                id="mainVBox"
                class="sapUiMediumMargin"
            >
                <!-- ========== Date Range Selection for Inspection Data ========== -->
                <VBox
                    id="datePickerSection"
                    class="sapUiSmallMarginBottom"
                >
                    <Label
                        id="dateLabel"
                        text="Select Inspection Date Range"
                        design="Bold"
                    />
                    <DateRangeSelection
                        id="inspectionDateRangePicker"
                        placeholder="Choose a date range"
                        displayFormat="dd/MM/yyyy"
                        change="onDateRangeChangeMain"
                        width="250px"
                    />
                </VBox>
                <!-- Tiles Section -->
                <l:HorizontalLayout
                    id="tilesLayout"
                    class="sapUiMediumMarginTop"
                    allowWrapping="true"
                >
                    <!-- Tile 1: Accepted Carriers -->
                    <GenericTile
                        id="acceptedTile"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom inspectionTile"
                        header="Accepted Inspections"
                        frameType="OneByOne"
                    >
                        <TileContent id="acceptedTileContent">
                            <NumericContent
                                id="acceptedNumericContent"
                                value="{viewModel>/acceptedCount}"
                                icon="sap-icon://inventory"
                                valueColor="Good"
                                withMargin="false"
                            />
                        </TileContent>
                    </GenericTile>
                    <!-- Tile 2: Rejected Carriers -->
                    <GenericTile
                        id="rejectedTile"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom inspectionTile"
                        header="Rejected Inspections"
                        frameType="OneByOne"
                    >
                        <TileContent id="rejectedTileContent">
                            <NumericContent
                                id="rejectedNumericContent"
                                value="{viewModel>/rejectedCount}"
                                icon="sap-icon://inventory"
                                valueColor="Error"
                                withMargin="false"
                            />
                        </TileContent>
                    </GenericTile>
                    <!-- Tile 3: Carrier Reservation Sheet  -->
                    <GenericTile
                        id="reservationSheetTile"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom reportTile"
                        header="Inspection Reports"
                        subheader="View Report"
                        frameType="OneByOne"
                        press="onNavigateToCarrierReport"
                    >
                        <TileContent id="reservationSheetTileContent">
                            <ImageContent
                                id="reservationSheetImage"
                                src="sap-icon://manager-insight"
                            />
                        </TileContent>
                    </GenericTile>
                    <!-- Tile 4: Carrier AI Summary -->
                    <GenericTile
                        id="aiSummaryTile"
                        class="sapUiTinyMarginBottom privaTile"
                        header="PRIVA Summary"
                        subheader="View PRIVA Summary"
                        frameType="OneByOne"
                        press="onNavigateToAiSummary"
                    >
                        <TileContent id="aiSummaryTileContent">
                            <ImageContent src="sap-icon://ai" />
                        </TileContent>
                    </GenericTile>

                    

                </l:HorizontalLayout>
            </VBox>
        </content>
    </Page>
</mvc:View>