<mvc:View
    controllerName="carrieranalytics.controller.AiSummary"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:l="sap.ui.layout"
    xmlns:c="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data"
    displayBlock="true"
    height="100%"
    busyIndicatorDelay="0"
>
    <Page
        id="aiSummaryPage"
        title="PRIVA Summary"
        showNavButton="true"
        navButtonPress="onNavBack"
    >
        <content>
            <IconTabBar
                id="idIconTabBar"
                expandable="false"
                class="sapUiResponsiveContentPadding"
            >
                <items>
                    <!-- ===== TAB 1: AI SUMMARY ===== -->
                    <IconTabFilter
                        key="aiSummary"
                        text="AI Summary"
                        icon="sap-icon://ai"
                    >
                        <VBox
                            id="aiSummaryVBox"
                            class="sapUiSmallMargin"
                        >
                            <!-- Loading Indicator -->
                            <!-- <BusyIndicator id="summaryBusyIndicator" visible="{viewModel>/isLoading}" text="Loading summary data..." class="sapUiMediumMargin" /> -->
                            <!-- Summary Content -->
                            <VBox
                                id="summaryContentVBox"
                                visible="{=${viewModel>/summaryData} &amp;&amp; ${viewModel>/summaryData/hasData}}"
                            >
                                <!-- Summary Details Section -->
                                <Panel
                                    id="detailsPanel"
                                    headerText="Operation Summary"
                                    class="sapUiSmallMarginBottom"
                                    expandable="false"
                                >
                                    <VBox
                                        id="detailsVBox"
                                        class="sapUiSmallMargin"
                                    >
                                        <Text
                                            id="summaryLine0"
                                            text="{viewModel>/summaryData/summaryLines/0}"
                                            wrapping="true"
                                            class="sapUiSmallMarginBottom"
                                        />
                                        <Text
                                            id="summaryLine1"
                                            text="{viewModel>/summaryData/summaryLines/1}"
                                            wrapping="true"
                                            class="sapUiSmallMarginBottom"
                                        />
                                        <Text
                                            id="summaryLine2"
                                            text="{viewModel>/summaryData/summaryLines/2}"
                                            wrapping="true"
                                            class="sapUiSmallMarginBottom"
                                        />
                                        <Text
                                            id="summaryLine3"
                                            text="{viewModel>/summaryData/summaryLines/3}"
                                            wrapping="true"
                                            class="sapUiSmallMarginBottom"
                                        />
                                        <Text
                                            id="summaryLine4"
                                            text="{viewModel>/summaryData/summaryLines/4}"
                                            wrapping="true"
                                            class="sapUiSmallMarginBottom"
                                        />
                                    </VBox>
                                </Panel>
                                <!-- Rejection Rate Trend Card -->
                                <Panel
                                    id="trendPanel"
                                    headerText="Inspection Rejection Trend"
                                    class="sapUiSmallMarginBottom"
                                    expandable="false"
                                >
                                    <VBox
                                        id="trendVBox"
                                        class="sapUiSmallMargin"
                                        alignItems="Center"
                                    >
                                        <!-- Previous Period -->
                                        <HBox
                                            id="prevPeriodHBox"
                                            alignItems="Center"
                                            justifyContent="Center"
                                            class="sapUiSmallMarginBottom"
                                        >
                                            <Text
                                                id="prevPeriodLabel"
                                                text="Previous Period: "
                                                class="sapUiTinyMarginEnd"
                                            />
                                            <Text
                                                id="prevPeriodValue"
                                                text="{viewModel>/summaryData/prevRejectionRate}%"
                                                class="sapUiMediumText"
                                            />
                                        </HBox>
                                        <!-- Arrow Indicator -->
                                        <Text
                                            id="arrowText"
                                            text="↓"
                                            class="sapUiSmallMarginBottom sapUiLargeText"
                                            textAlign="Center"
                                        />
                                        <!-- Current Period -->
                                        <HBox
                                            id="currPeriodHBox"
                                            alignItems="Center"
                                            justifyContent="Center"
                                            class="sapUiSmallMarginBottom"
                                        >
                                            <Text
                                                id="currPeriodLabel"
                                                text="Current Period: "
                                                class="sapUiTinyMarginEnd"
                                            />
                                            <Text
                                                id="currPeriodValue"
                                                text="{viewModel>/summaryData/rejectionRate}%"
                                                class="sapUiMediumText sapUiNegativeTextColor"
                                                textAlign="Center"
                                            />
                                        </HBox>
                                        <!-- Delta/Change -->
                                        <HBox
                                            id="deltaHBox"
                                            alignItems="Center"
                                            justifyContent="Center"
                                            class="sapUiSmallMarginTop"
                                        >
                                            <Text
                                                id="deltaLabel"
                                                text="Change: "
                                                class="sapUiTinyMarginEnd"
                                            />
                                            <Text
                                                id="deltaValue"
                                                text="{= ${viewModel>/summaryData/rateDeltaValue} + '%'}"
                                                class="sapUiMediumText"
                                                textAlign="Center"
                                            />
                                            <Text
                                                id="deltaTrend"
                                                text="{viewModel>/summaryData/rateTrend}"
                                                class="sapUiSmallMarginBegin sapUiMediumText"
                                            />
                                        </HBox>
                                    </VBox>
                                </Panel>
                            </VBox>
                            <!-- No Data Message -->
                            <MessageStrip
                                id="noDataMessageStrip"
                                text="No summary data available for the selected date range."
                                type="Information"
                                showIcon="true"
                                visible="{=
                                    ${viewModel>/summaryData}
                                    &amp;&amp; !${viewModel>/summaryData/hasData}
                                    &amp;&amp; !${viewModel>/isLoading}
                                }"
                                class="sapUiSmallMargin"
                            />
                        </VBox>
                    </IconTabFilter>
                    <!-- ===== TAB 2: INSIGHTS ===== -->
                   
                    <IconTabFilter
                        id="insightsTabFilter"
                        key="insights"
                        text="Op. Insights"
                        icon="sap-icon://bar-chart"
                        
                    >
                        <VBox class="sapUiSmallMargin">
                            <!-- Loading -->
                            <BusyIndicator
                                visible="{viewModel>/isLoading}"
                                text="Loading insights..."
                                class="sapUiMediumMargin"
                            />
                            <!-- INSIGHTS LIST -->
                            <l:Grid
                                visible="{= ${viewModel>/insights}.length > 0 &amp;&amp; !${viewModel>/isLoading} }"
                                defaultSpan="L6 M6 S12"
                                hSpacing="1"
                                vSpacing="1"
                                containerQuery="true"
                                content="{viewModel>/insights}"
                            >
                                <l:content>
                                    <Panel
                                        expandable="false"
                                        width="100%"
                                        class="sapUiSmallMarginBottom"
                                        visible="{
                                            parts: ['viewModel>KeyText'],
                                            formatter: '.isInsightAvailable'
                                        }"
                                    >
                                        <headerToolbar>
                                            <OverflowToolbar>
                                                <Title
                                                    level="H4"
                                                    text="{
                                                        parts: [
                                                            'viewModel>InsightType',
                                                            'viewModel>KeyText',
                                                            'viewModel>KeyId',
                                                            'viewModel>PeriodType'
                                                        ],
                                                        formatter: '.formatPanelHeader'
                                                    }"
                                                />
                                                <ToolbarSpacer />
                                                <ObjectStatus
                                                    inverted="true"
                                                    text="{viewModel>Severity}"
                                                    state="{
                                                        path: 'viewModel>Severity',
                                                        formatter: '.formatSeverityState'
                                                    }"
                                                />
                                            </OverflowToolbar>
                                        </headerToolbar>
                                        <VBox class="sapUiMediumMargin">
                                            <!-- Insight -->
                                            <VBox class="sapUiSmallMarginBottom">
                                                <Label text="Insight" />
                                                <Text
                                                    wrapping="true"
                                                    text="{
                                                        parts: [
                                                            'viewModel>InsightType',
                                                            'viewModel>KeyText',
                                                            'viewModel>KeyId',
                                                            'viewModel>PeriodType'
                                                        ],
                                                        formatter: '.formatInsightHeadline'
                                                    }"
                                                />
                                            </VBox>
                                            <!-- Evidence -->
                                            <VBox>
                                                <Label text="Evidence" />
                                                <Text
                                                    wrapping="true"
                                                    text="{
                                                        parts: [
                                                            'viewModel>InsightType',
                                                            'viewModel>RejectionCount',
                                                            'viewModel>TotalRejections',
                                                            'viewModel>RejectionRate',
                                                            'viewModel>PeriodType'
                                                        ],
                                                        formatter: '.formatInsightEvidence'
                                                    }"
                                                />
                                            </VBox>
                                        </VBox>
                                    </Panel>
                                </l:content>
                            </l:Grid>
                        </VBox>
                        <!-- No Data -->
                        <MessageStrip
                            text="No insights available for the selected date range."
                            type="Information"
                            showIcon="true"
                            visible="{= ${viewModel>/insights}.length === 0 &amp;&amp; !${viewModel>/isLoading} }"
                            class="sapUiSmallMargin"
                        />
                    </IconTabFilter>

                    <!-- ===== TAB 3: TREND ANALYSIS ===== -->
                    <IconTabFilter
                        id="trendTabFilter"
                        key="trendAnalysis"
                        text="Inspection Trends"
                        icon="sap-icon://trend-up"
                    >
                        <VBox class="sapUiSmallMargin">
                            <!-- Chart Type Toggle -->
                            <Toolbar class="sapUiSmallMarginTop">
                                <Title text="Daily Inspection Trends" level="H3"/>
                                <ToolbarSpacer/>
                                <SegmentedButton
                                    selectedKey="{viewModel>/trendChartType}"
                                    selectionChange="onTrendChartTypeChange"
                                    visible="{viewModel>/trendShowChart}"
                                >
                                    <items>
                                        <SegmentedButtonItem key="column" icon="sap-icon://horizontal-bar-chart" text="Bar Chart"/>
                                        <SegmentedButtonItem key="line" icon="sap-icon://line-chart" text="Line Chart"/>
                                    </items>
                                </SegmentedButton>
                            </Toolbar>
                            <!-- Loading -->
                            <BusyIndicator
                                visible="{viewModel>/trendIsLoading}"
                                text="Fetching trend data..."
                                class="sapUiMediumMargin"
                            />
                            <!-- Chart Container -->
                            <VBox visible="{viewModel>/trendShowChart}" class="sapUiSmallMargin">
                                <ScrollContainer horizontal="true" vertical="false" height="450px" width="100%">
                                    <viz:VizFrame
                                        id="aiTrendChart"
                                        uiConfig="{ applicationSet: 'fiori' }"
                                        height="400px"
                                        width="100%"
                                        vizType="{viewModel>/trendChartType}"
                                        selectData="onTrendChartBarSelect"
                                        vizProperties="{
                                            plotArea: {
                                                dataLabel: { visible: true }
                                            },
                                            title: { visible: false },
                                            legend: { visible: true },
                                            interaction: {
                                                selectability: { mode: 'SINGLE' }
                                            }
                                        }"
                                    >
                                        <viz:dataset>
                                            <viz.data:FlattenedDataset data="{viewModel>/trendChartData}">
                                                <viz.data:dimensions>
                                                    <viz.data:DimensionDefinition name="Date" value="{viewModel>date}"/>
                                                </viz.data:dimensions>
                                                <viz.data:measures>
                                                    <viz.data:MeasureDefinition name="Accepted" value="{viewModel>accepted}"/>
                                                    <viz.data:MeasureDefinition name="Rejected" value="{viewModel>rejected}"/>
                                                </viz.data:measures>
                                            </viz.data:FlattenedDataset>
                                        </viz:dataset>
                                        <viz:feeds>
                                            <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Date"/>
                                            <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Accepted,Rejected"/>
                                        </viz:feeds>
                                    </viz:VizFrame>
                                </ScrollContainer>
                                <!-- Summary Stats -->
                                <l:Grid defaultSpan="L3 M6 S12" hSpacing="1" vSpacing="1" containerQuery="true" class="sapUiMediumMarginTop">
                                    <VBox alignItems="Center" class="sapUiSmallMarginBottom">
                                        <layoutData><l:GridData span="L3 M6 S12"/></layoutData>
                                        <Label text="Total Accepted" design="Bold"/>
                                        <Text text="{viewModel>/trendTotalAccepted}" class="sapUiTinyMarginTop"/>
                                    </VBox>
                                    <VBox alignItems="Center" class="sapUiSmallMarginBottom">
                                        <layoutData><l:GridData span="L3 M6 S12"/></layoutData>
                                        <Label text="Total Rejected" design="Bold"/>
                                        <Text text="{viewModel>/trendTotalRejected}" class="sapUiTinyMarginTop"/>
                                    </VBox>
                                    <VBox alignItems="Center" class="sapUiSmallMarginBottom">
                                        <layoutData><l:GridData span="L3 M6 S12"/></layoutData>
                                        <Label text="Avg. Daily Accepted" design="Bold"/>
                                        <Text text="{viewModel>/trendAvgAccepted}" class="sapUiTinyMarginTop"/>
                                    </VBox>
                                    <VBox alignItems="Center" class="sapUiSmallMarginBottom">
                                        <layoutData><l:GridData span="L3 M6 S12"/></layoutData>
                                        <Label text="Avg. Daily Rejected" design="Bold"/>
                                        <Text text="{viewModel>/trendAvgRejected}" class="sapUiTinyMarginTop"/>
                                    </VBox>
                                </l:Grid>
                            </VBox>
                            <!-- No Data -->
                            <MessageStrip
                                text="No trend data available for the selected date range."
                                type="Information"
                                showIcon="true"
                                visible="{viewModel>/trendShowNoData}"
                                class="sapUiSmallMargin"
                            />
                        </VBox>
                    </IconTabFilter>

            </items>
        </IconTabBar>
    </content>
</Page>
</mvc:View>
