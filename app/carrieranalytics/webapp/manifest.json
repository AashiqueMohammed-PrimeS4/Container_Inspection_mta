{
  "_version": "1.73.1",
  "sap.app": {
    "id": "carrieranalytics",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.22.0",
      "toolsId": "d43fcc99-145f-43be-9e76-7d7592bef937"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata/PWXSI/INSPECTION_ANALYTIC_APP_SRV/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      },
      "inspectionService": {
        "uri": "/odata/v2/inspection/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "carrieranalytics-display": {
          "semanticObject": "carrieranalytics",
          "action": "display",
          "title": "{{carrieranalytics-display.flpTitle}}",
          "subTitle": "{{carrieranalytics-display.flpSubtitle}}",
          "icon": "sap-icon://bar-chart",
          "info" : "Powered by WarehouseX",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "Container_router"
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "carrieranalytics.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {}
      },
      "inspectionModel": {
        "dataSource": "inspectionService",
        "preload": false,
        "settings": {
          "useBatch": false
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "carrieranalytics.view",
        "async": true,
        "viewPath": "carrieranalytics.view"
      },
      "routes": [
        {
          "name": "RouteMain",
          "pattern": ":?query:",
          "target": [
            "TargetMain"
          ]
        },
        {
          "name": "RouteCarrierReport",
          "pattern": "CarrierReport:?query:",
          "target": [
            "TargetCarrierReport"
          ]
        },
        {
          "name": "RouteAiSummary",
          "pattern": "aiSummary:?query:",
          "target": "AiSummary"
        }
      ],
      "targets": {
        "TargetMain": {
          "id": "Main",
          "name": "Main"
        },
        "TargetCarrierReport": {
          "id": "CarrierReport",
          "name": "CarrierInspectionReport"
        },
        "AiSummary": {
          "id": "AiSummary",
          "name": "AiSummary"
        }
      }
    },
    "rootView": {
      "viewName": "carrieranalytics.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
