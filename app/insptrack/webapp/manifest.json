{
  "_version": "1.73.1",
  "sap.app": {
    "id": "insptrack",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.22.0",
      "toolsId": "76e288d6-9c11-4f0f-aa9d-365258a1edfa"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata/sap/ZINSPECTION_APP_SRV/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      },
      "catalogService": {
        "uri": "/odata/v2/catalog/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/catalogService/metadata.xml",
          "odataVersion": "2.0"
        }
      },
      "ocrService": {
        "uri": "/odata/v2/ocr/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0"
        }
      },
      "DefectDet": {
        "uri": "/odata/v2/defect/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "localUri": "localService/DefectDet/metadata.xml"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "insptrack-create": {
          "semanticObject": "insptrack",
          "action": "create",
          "title": "{{insptrack-create.flpTitle}}",
          "subTitle": "{{insptrack-create.flpSubtitle}}",
          "icon": "sap-icon://camera",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "insptrack.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {}
      },
      "catalog": {
        "dataSource": "catalogService",
        "preload": false,
        "settings": {
          "useBatch": false
        }
      },
      "ocr": {
        "dataSource": "ocrService",
        "preload": false,
        "settings": {
          "operationMode": "Server",
          "groupId": "$direct",
          "useBatch": false
        }
      },
      "defect": {
        "dataSource": "DefectDet",
        "preload": false,
        "settings": {
          "operationMode": "Server",
          "groupId": "$direct",
          "useBatch": false
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "insptrack.view",
        "async": true,
        "viewPath": "insptrack.view"
      },
      "routes": [
        {
          "name": "RouteMain",
          "pattern": ":?query:",
          "target": [
            "TargetMain"
          ]
        }
      ],
      "targets": {
        "TargetMain": {
          "id": "Main",
          "name": "Main"
        }
      }
    },
    "rootView": {
      "viewName": "insptrack.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}