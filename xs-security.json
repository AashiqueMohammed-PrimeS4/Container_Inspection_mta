{
  "xsappname": "container_inspection_mta",
  "tenant-mode": "dedicated",
  "description": "Security profile of called application",
  "scopes": [
    {
      "name": "uaa.user",
      "description": "UAA"
    },
    {
      "name": "$XSAPPNAME.WorkzoneUser.Access",
      "description": "Generic access for Work Zone site visibility"
    }
  ],
  "role-templates": [
    {
      "name": "Token_Exchange",
      "description": "UAA",
      "scope-references": [
        "uaa.user"
      ]
    },
    {
      "name": "WorkzoneUser_Access",
      "description": "Generic role for SAP Build Work Zone site access",
      "scope-references": [
        "$XSAPPNAME.WorkzoneUser.Access"
      ]
    }
  ],
  "oauth2-configuration": {
    "credential-types": [
      "binding-secret",
      "x509"
    ]
  }
}